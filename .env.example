# ---- Backend (copy to .env at the repo root or in backend/) ----
# Database: SQLite works out of the box. For PostgreSQL (docker compose up db):
#   DATABASE_URL=postgresql+psycopg://udyam:udyam@localhost:5432/udyam
# DATABASE_URL=sqlite:///./storage/udyam.db

# Secrets - CHANGE THESE outside local development
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=            # Fernet key for documents at rest: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ADMIN_EMAIL=admin@accel.example
ADMIN_PASSWORD=ChangeMe!123

# Dataset location (the original files are only ever read)
# DATA_DIR=./assignment/data

# "Today" for date checks. The dataset README says to use 2026-07-15. Leave empty to use the real date.
REFERENCE_DATE=2026-07-15

# AI advisor. LLM_PROVIDER = auto | anthropic | mock.  With no key the advisor runs on the built-in rules provider.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Sign-In: OAuth client ID (type "Web application") from console.cloud.google.com > APIs & Services > Credentials.
# Add your site origin (e.g. http://localhost:3000 and https://udyam-digital.vercel.app) under "Authorised JavaScript origins".
# Empty = the Google buttons show as "not configured"; email + password keeps working.
GOOGLE_CLIENT_ID=

# Commercial assumption not present in the catalogue (see docs/ARCHITECTURE.md)
GST_RATE_PERCENT=18

# Privacy
DOCUMENT_RETENTION_DAYS=30
CORS_ORIGINS=http://localhost:3000

# ---- Frontend (frontend/.env.local) ----
# Where the Next.js server proxies /api/* to. The browser never sees this URL or any key.
BACKEND_URL=http://127.0.0.1:8000
